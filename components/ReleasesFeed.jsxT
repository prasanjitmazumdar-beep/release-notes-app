"use client"
import React, { useState, useEffect } from 'react';
import { Search, Filter, ChevronDown, Calendar, User, Tag } from 'lucide-react';

export default function ReleaseNotesWebpage() {
  const [selectedTeam, setSelectedTeam] = useState('all');
  const [searchQuery, setSearchQuery] = useState('');
  const [expandedRelease, setExpandedRelease] = useState(null);

  const releases = [
    {
      id: 1,
      week: '2026-07-25',
      team: 'Gen AI',
      badge: '✨',
      title: '🚀 BrightTeacher Bot Now Live for All 🤖✨',
      summary: 'AI-powered assistant designed to simplify everyday workflows and provide instant support to teachers.',
      content: `We've rolled out the BrightTeacher Bot, an AI-powered assistant designed to simplify everyday workflows and provide instant support to teachers — all in one place 🙌

✨ What's New:
📅 Class Schedule & Upcoming Classes
- View daily schedule with student names, class types, timings, and lesson plan links

👤 Teacher Profile & Account Info
- Access personal details, account status, performance metrics, and team lead contact info

💰 Monthly Earnings Report
- Detailed earnings breakdown including bonuses, penalties, and net payout

📘 Payment Policy & Rates
- Clear explanations of payment structures across class types

🔍 Payout Issue Resolution
- Automated checks to investigate and resolve payment discrepancies

📝 Leave Application Support
- View impact on classes, leave credits, and penalties before applying

❓ FAQ & Knowledge Base
- Instant answers for platform queries, troubleshooting, and smart escalation

🔗 Referral Link Generation
- Easily generate and share referral links

🎯 Impact:
- Faster access to critical information ⚡
- Reduced dependency on manual support 🙌
- Improved teacher experience and efficiency`,
      owner: 'Priya S.',
      publishedDate: '2026-07-19',
      featured: true,
      impact: 'High',
      type: 'feature'
    },
    {
      id: 2,
      week: '2026-07-25',
      team: 'Coding',
      badge: '⚡',
      title: 'Code Editor Performance Boost',
      summary: 'Reduced compilation time by 40% for Python sandboxes. Students get instant feedback.',
      content: `Compilation time for Python sandboxes reduced by 40%. Students get instant feedback on their code submissions.

What's Improved:
- Optimized container startup
- Reduced cold boot latency
- Improved error message clarity for debugging
- Better syntax highlighting performance

Impact:
- Students spend more time coding, less time waiting
- Increased lesson completion rates
- Better debugging experience

Technical Details:
- Moved to serverless execution model
- Implemented caching layer
- Optimized Docker image size by 60%`,
      owner: 'Dev Team',
      publishedDate: '2026-07-19',
      featured: false,
      impact: 'Medium',
      type: 'improvement'
    },
    {
      id: 3,
      week: '2026-07-25',
      team: 'Robotics',
      badge: '✨',
      title: 'Robotics Simulation Gallery Launched',
      summary: 'Interactive 3D model viewers showcase student robotics projects. Encourages peer learning.',
      content: `New showcase page displays student robotics projects with interactive 3D model viewers. Encourages peer learning and project sharing.

Features:
- Interactive Three.js 3D rendering
- Student portfolio integration
- Project filtering by difficulty level
- Comments and collaboration features
- Shareable project links
- Achievement badges

Impact:
- Increased student engagement by 35%
- Better peer learning opportunities
- Portfolio building for students
- Teacher assessment tools included`,
      owner: 'Alex M.',
      publishedDate: '2026-07-19',
      featured: false,
      impact: 'Medium',
      type: 'feature'
    },
    {
      id: 4,
      week: '2026-07-18',
      team: 'Finance',
      badge: '✓',
      title: 'Finance Module Critical Fixes',
      summary: 'Fixed currency conversion errors and session timeout issues during exercises.',
      content: `Fixed incorrect currency conversion in portfolio tracking. Resolved session timeout issues during long calculation exercises.

Fixes Applied:
- Edge cases in decimal precision handling corrected
- Session persistence now works across browser tabs
- Currency exchange rate calculation fixed
- Timeout issues resolved

What was wrong:
- Users lost progress during long sessions
- Currency conversions showed incorrect values
- Multiple tabs didn't sync properly

Now working:
- Sessions persist across all browsers
- Accurate conversions for 150+ currencies
- Real-time sync across tabs`,
      owner: 'QA Team',
      publishedDate: '2026-07-18',
      featured: false,
      impact: 'High',
      type: 'fix'
    }
  ];

  const filteredReleases = releases.filter(release => {
    const matchesTeam = selectedTeam === 'all' || release.team === selectedTeam;
    const matchesSearch = release.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
                         release.content.toLowerCase().includes(searchQuery.toLowerCase());
    return matchesTeam && matchesSearch;
  });

  const featuredRelease = filteredReleases.find(r => r.featured);
  const recentReleases = filteredReleases.filter(r => !r.featured).sort((a, b) => 
    new Date(b.publishedDate) - new Date(a.publishedDate)
  );
  const archivedReleases = releases.filter(r => r.publishedDate < '2026-07-25');

  const teams = ['all', 'Gen AI', 'Coding', 'Robotics', 'Finance', 'Tech'];

  const getBadgeStyles = (type) => {
    const styles = {
      feature: 'bg-purple-100 text-purple-800 border-purple-200',
      improvement: 'bg-blue-100 text-blue-800 border-blue-200',
      fix: 'bg-green-100 text-green-800 border-green-200'
    };
    return styles[type] || 'bg-gray-100 text-gray-800';
  };

  return (
    <div className="min-h-screen bg-gradient-to-b from-slate-50 via-white to-slate-50">
      {/* Header */}
      <div className="sticky top-0 z-40 bg-white border-b border-slate-200">
        <div className="max-w-6xl mx-auto px-6 py-6">
          <div className="flex items-center justify-between mb-6">
            <div>
              <h1 className="text-3xl font-bold text-slate-900">Release Notes</h1>
              <p className="text-slate-600 mt-1">What's new at BrightCHAMPS</p>
            </div>
            <div className="text-right text-sm text-slate-500">
              <p>Last updated: Friday, Jul 19 • 2:30 PM</p>
              <p className="mt-1"><strong>This week:</strong> 4 releases • 3 teams</p>
            </div>
          </div>

          {/* Search & Filter */}
          <div className="flex flex-col sm:flex-row gap-4">
            <div className="flex-1 relative">
              <Search className="absolute left-3 top-3 text-slate-400" size={20} />
              <input
                type="text"
                placeholder="Search releases..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent"
              />
            </div>
            <div className="flex gap-2 flex-wrap">
              {teams.map((team) => (
                <button
                  key={team}
                  onClick={() => setSelectedTeam(team)}
                  className={`px-4 py-2 rounded-lg font-medium transition-all ${
                    selectedTeam === team
                      ? 'bg-purple-600 text-white'
                      : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                  }`}
                >
                  {team === 'all' ? '📊 All' : team}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      {/* Main Content */}
      <div className="max-w-6xl mx-auto px-6 py-12">
        
        {/* Featured Release (Dashboard Style) */}
        {featuredRelease && (
          <div className="mb-16">
            <h2 className="text-sm font-bold text-purple-600 uppercase tracking-widest mb-4">
              📌 Featured This Week
            </h2>
            <div className="bg-gradient-to-br from-purple-50 to-slate-50 border-2 border-purple-200 rounded-2xl p-8 md:p-12">
              <div className="flex items-start gap-4 mb-6">
                <span className={`inline-block px-4 py-2 rounded-full text-sm font-bold border ${getBadgeStyles(featuredRelease.type)}`}>
                  {featuredRelease.badge} {featuredRelease.type === 'feature' ? 'New Feature' : 'Improvement'}
                </span>
                <span className="text-xs font-bold text-purple-700 bg-purple-100 px-3 py-1 rounded-full">
                  High Impact
                </span>
              </div>
              <h3 className="text-4xl md:text-5xl font-black text-slate-900 mb-4 leading-tight">
                {featuredRelease.title}
              </h3>
              <p className="text-xl text-slate-700 mb-6 leading-relaxed">
                {featuredRelease.summary}
              </p>
              <div className="grid sm:grid-cols-3 gap-6 mb-8 pt-6 border-t border-purple-200">
                <div>
                  <span className="text-xs text-slate-600 uppercase font-bold">Team</span>
                  <p className="font-semibold text-slate-900 mt-1">{featuredRelease.team}</p>
                </div>
                <div>
                  <span className="text-xs text-slate-600 uppercase font-bold">Owner</span>
                  <p className="font-semibold text-slate-900 mt-1">{featuredRelease.owner}</p>
                </div>
                <div>
                  <span className="text-xs text-slate-600 uppercase font-bold">Published</span>
                  <p className="font-semibold text-slate-900 mt-1">{new Date(featuredRelease.publishedDate).toLocaleDateString()}</p>
                </div>
              </div>
              <button
                onClick={() => setExpandedRelease(expandedRelease === featuredRelease.id ? null : featuredRelease.id)}
                className="text-purple-600 font-bold hover:text-purple-700 flex items-center gap-2"
              >
                {expandedRelease === featuredRelease.id ? 'Show Less' : 'Read Full Details'}
                <ChevronDown size={20} className={expandedRelease === featuredRelease.id ? 'rotate-180' : ''} />
              </button>
              {expandedRelease === featuredRelease.id && (
                <div className="mt-6 pt-6 border-t border-purple-200">
                  <div className="prose prose-sm max-w-none text-slate-700 whitespace-pre-wrap leading-relaxed">
                    {featuredRelease.content}
                  </div>
                </div>
              )}
            </div>
          </div>
        )}

        {/* Live Feed (Stream Style) */}
        <div className="mb-16">
          <h2 className="text-sm font-bold text-slate-600 uppercase tracking-widest mb-4 flex items-center gap-2">
            📰 Live Feed <span className="ml-auto text-xs bg-slate-100 px-2 py-1 rounded-full font-normal">Newest First</span>
          </h2>
          <div className="space-y-6">
            {recentReleases.length > 0 ? (
              recentReleases.map((release) => (
                <div
                  key={release.id}
                  className="bg-white border-2 border-slate-200 hover:border-purple-300 rounded-xl p-6 md:p-8 transition-all hover:shadow-lg cursor-pointer"
                  onClick={() => setExpandedRelease(expandedRelease === release.id ? null : release.id)}
                >
                  <div className="flex items-start justify-between gap-4">
                    <div className="flex-1">
                      <div className="flex items-center gap-3 mb-3">
                        <span className={`inline-block px-3 py-1 rounded-full text-xs font-bold border ${getBadgeStyles(release.type)}`}>
                          {release.badge} {release.type === 'feature' ? 'New' : release.type === 'improvement' ? 'Improved' : 'Fixed'}
                        </span>
                        <span className="text-xs font-bold text-slate-500 uppercase">{release.team}</span>
                        <span className="text-xs text-slate-400">•</span>
                        <span className="text-xs text-slate-500">{new Date(release.publishedDate).toLocaleDateString()}</span>
                      </div>
                      <h3 className="text-xl md:text-2xl font-bold text-slate-900 mb-2">
                        {release.title}
                      </h3>
                      <p className="text-slate-700 leading-relaxed">
                        {release.summary}
                      </p>
                    </div>
                    <ChevronDown
                      size={24}
                      className={`text-slate-400 flex-shrink-0 transition-transform ${expandedRelease === release.id ? 'rotate-180' : ''}`}
                    />
                  </div>

                  {expandedRelease === release.id && (
                    <div className="mt-6 pt-6 border-t border-slate-200">
                      <div className="prose prose-sm max-w-none text-slate-700 whitespace-pre-wrap leading-relaxed mb-6">
                        {release.content}
                      </div>
                      <div className="grid sm:grid-cols-2 gap-4 pt-4 border-t border-slate-200">
                        <div className="flex items-center gap-2 text-sm">
                          <User size={16} className="text-slate-400" />
                          <span className="text-slate-600">Owner: <strong>{release.owner}</strong></span>
                        </div>
                        <div className="flex items-center gap-2 text-sm">
                          <Calendar size={16} className="text-slate-400" />
                          <span className="text-slate-600">Published: <strong>{new Date(release.publishedDate).toLocaleDateString()}</strong></span>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              ))
            ) : (
              <div className="text-center py-12 bg-slate-50 rounded-lg">
                <p className="text-slate-600">No releases found matching your filters.</p>
              </div>
            )}
          </div>
        </div>

        {/* Archive Section (Past Releases) */}
        {archivedReleases.length > 0 && (
          <div>
            <h2 className="text-sm font-bold text-slate-600 uppercase tracking-widest mb-6">
              🗂️ Archive
            </h2>
            <div className="bg-slate-50 rounded-xl p-8">
              <div className="space-y-4">
                {archivedReleases.map((release) => (
                  <div
                    key={release.id}
                    className="bg-white p-4 rounded-lg hover:shadow-md transition-all cursor-pointer border border-slate-200"
                    onClick={() => setExpandedRelease(expandedRelease === release.id ? null : release.id)}
                  >
                    <div className="flex items-center justify-between">
                      <div className="flex-1">
                        <div className="flex items-center gap-2 mb-2">
                          <span className="font-bold text-slate-900">{release.title}</span>
                          <span className="text-xs bg-slate-100 px-2 py-1 rounded text-slate-600">{release.team}</span>
                        </div>
                        <p className="text-sm text-slate-600">
                          {new Date(release.publishedDate).toLocaleDateString()} • {release.summary}
                        </p>
                      </div>
                      <ChevronDown
                        size={20}
                        className={`text-slate-400 flex-shrink-0 transition-transform ${expandedRelease === release.id ? 'rotate-180' : ''}`}
                      />
                    </div>
                    {expandedRelease === release.id && (
                      <div className="mt-4 pt-4 border-t border-slate-200 text-sm text-slate-700 whitespace-pre-wrap">
                        {release.content}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}
      </div>

      {/* Footer */}
      <div className="bg-slate-100 border-t border-slate-200 mt-16">
        <div className="max-w-6xl mx-auto px-6 py-12">
          <div className="grid md:grid-cols-3 gap-12">
            <div>
              <h3 className="font-bold text-slate-900 mb-3">About These Updates</h3>
              <p className="text-sm text-slate-600">Weekly release notes from the BrightCHAMPS product and engineering teams.</p>
            </div>
            <div>
              <h3 className="font-bold text-slate-900 mb-3">Questions?</h3>
              <p className="text-sm text-slate-600">Reach out to your team lead or ask in #product-updates on Cliq.</p>
            </div>
            <div>
              <h3 className="font-bold text-slate-900 mb-3">Feedback</h3>
              <p className="text-sm text-slate-600">Help us improve! React with ❤️ or 👍 to your favorite releases.</p>
            </div>
          </div>
          <div className="border-t border-slate-300 mt-8 pt-8 text-center text-sm text-slate-600">
            <p>© 2026 BrightCHAMPS. Last updated: {new Date().toLocaleString()}</p>
          </div>
        </div>
      </div>
    </div>
  );
}
