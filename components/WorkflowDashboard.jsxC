"use client"
import React, { useState, useEffect } from 'react';
import { CheckCircle, AlertCircle, Send, Eye, Upload, Zap } from 'lucide-react';

export default function ReleaseNotesWorkflowDashboard() {
  const [currentDay, setCurrentDay] = useState('monday');
  const [submissions, setSubmissions] = useState({
    genAI: false,
    coding: false,
    robotics: false
  });
  const [activeStep, setActiveStep] = useState(0);
  const [isPublished, setIsPublished] = useState(false);
  const [floatingIcons, setFloatingIcons] = useState([]);

  useEffect(() => {
    const icons = Array.from({ length: 8 }).map((_, i) => ({
      id: i,
      x: Math.random() * 100,
      y: Math.random() * 100,
      duration: 3 + Math.random() * 2,
      delay: Math.random() * 0.5
    }));
    setFloatingIcons(icons);
  }, []);

  const workflow = [
    {
      day: 'monday',
      dayName: 'Monday',
      time: '9:00 AM',
      action: 'Send Form Notification',
      icon: '📝',
      color: 'from-blue-500 to-purple-500',
      description: 'Teams receive form link and deadline',
      completed: true
    },
    {
      day: 'wednesday',
      dayName: 'Wednesday',
      time: '5:00 PM',
      action: 'Check Submissions',
      icon: '✅',
      color: 'from-purple-500 to-pink-500',
      description: 'Verify who submitted, send reminders',
      completed: currentDay !== 'monday'
    },
    {
      day: 'thursday',
      dayName: 'Thursday',
      time: '2:00 PM',
      action: 'Get Missing List',
  
    icon: '🚨',
      color: 'from-pink-500 to-red-500',
      description: 'Receive list of non-submitters',
      completed: currentDay === 'thursday' || currentDay === 'friday'
    },
    {
      day: 'friday',
      dayName: 'Friday',
      time: '8:00 AM',
      action: 'Review & Go Live',
      icon: '🚀',
      color: 'from-green-500 to-emerald-500',
      description: 'Approve and publish to Vercel',
      completed: isPublished
    }
  ];

  const teams = [
    { id: 'genAI', name: 'Gen AI Team', color: 'from-purple-400 to-purple-600' },
    { id: 'coding', name: 'Coding Team', color: 'from-cyan-400 to-blue-600' },
    { id: 'robotics', name: 'Robotics Team', color: 'from-orange-400 to-red-600' }
  ];

  const handleDayChange = (day) => {
    setCurrentDay(day);
    setActiveStep(workflow.findIndex(w => w.day === day));
  };

  const handleSubmit = (teamId) => {
    setSubmissions(prev => ({
      ...prev,
      [teamId]: !prev[teamId]
    }));
  };

  const handlePublish = () => {
    setIsPublished(true);
    setTimeout(() => {
      alert('✨ Released published to Vercel! 🚀');
    }, 500);
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-950 via-purple-900 to-slate-900 overflow-hidden relative">
      <div className="absolute inset-0 overflow-hidden pointer-events-none">
        {floatingIcons.map(icon => (
          <div
            key={icon.id}
            className="absolute text-3xl opacity-10"
            style={{
              left: `${icon.x}%`,
              top: `${icon.y}%`,
              animation: `float ${icon.duration}s ease-in-out infinite`,
              animationDelay: `${icon.delay}s`
            }}
          >
            {['🚀', '📊', '💡', '⚙️', '🎯', '✨', '🔄', '📈'][icon.id % 8]}
          </div>
        ))}
      </div>

      <div className="absolute inset-0 bg-[linear-gradient(rgba(139,92,246,0.1)_1px,transparent_1px),linear-gradient(90deg,rgba(139,92,246,0.1)_1px,transparent_1px)] bg-[size:50px_50px] opacity-20 pointer-events-none" />

      <div className="relative z-10">
        <div className="relative h-screen flex items-center justify-center px-6">
          <div className="max-w-7xl mx-auto w-full">
            <div className="grid md:grid-cols-2 gap-12 items-center">
              <div className="space-y-8">
                <div className="space-y-4">
                  <div className="inline-block">
                    <span className="text-sm font-bold text-purple-400 uppercase tracking-widest bg-purple-500/10 border border-purple-500/30 px-4 py-2 rounded-full">
                      ✨ Release Notes Automation
                    </span>
                  </div>
                  <h1 className="text-6xl md:text-7xl font-black text-white leading-tight">
                    Automate Your<br/>
                    <span className="bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400 bg-clip-text text-transparent">
                      Release Notes
                    </span>
                  </h1>
                  <p className="text-xl text-slate-300 leading-relaxed max-w-xl">
                    One-click publishing. Smart workflows. Zero manual posts. Get your release notes live on Vercel every Friday.
                  </p>
                </div>

                <div className="flex gap-4 pt-8">
                  <button className="px-8 py-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-bold rounded-xl hover:shadow-2xl hover:shadow-purple-500/50 transition-all transform hover:scale-105 duration-300">
                    Get Started
                  </button>
                  <button className="px-8 py-4 border-2 border-purple-400 text-purple-300 font-bold rounded-xl hover:bg-purple-500/10 transition-all">
                    Watch Demo
                  </button>
                </div>

                <div className="grid grid-cols-3 gap-6 pt-12 border-t border-purple-500/30">
                  <div className="space-y-2">
                    <p className="text-3xl font-bold text-white">4</p>
                    <p className="text-sm text-slate-400">Automated Steps</p>
                  </div>
                  <div className="space-y-2">
                    <p className="text-3xl font-bold text-white">1h</p>
                    <p className="text-sm text-slate-400">Weekly Time Saved</p>
                  </div>
                  <div className="space-y-2">
                    <p className="text-3xl font-bold text-white">100%</p>
                    <p className="text-sm text-slate-400">Automated</p>
                  </div>
                </div>
              </div>

              <div className="relative h-96 md:h-[600px]">
                <div className="absolute inset-0 bg-gradient-to-r from-purple-500/20 to-pink-500/20 rounded-3xl blur-2xl" />
                <div className="absolute inset-0 bg-gradient-to-br from-purple-500/10 to-transparent rounded-3xl border border-purple-500/30 backdrop-blur-xl overflow-hidden">
                  <div className="w-full h-full bg-gradient-to-br from-slate-800 to-slate-900 flex items-center justify-center">
                    <div className="text-center space-y-4">
                      <div className="text-6xl">🚀</div>
                      <p className="text-white font-bold text-lg">Release Notes Workflow</p>
                      <p className="text-slate-400 text-sm">Monday → Friday</p>
                    </div>
                  </div>
                </div>

                <div className="absolute -top-6 -right-6 w-24 h-24 bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl blur-2xl opacity-30 animate-pulse" />
                <div className="absolute -bottom-6 -left-6 w-32 h-32 bg-gradient-to-tr from-blue-500 to-purple-500 rounded-full blur-3xl opacity-20 animate-pulse" />
              </div>
            </div>
          </div>
        </div>

        <div className="py-20 px-6 bg-slate-900/50 backdrop-blur-xl">
          <div className="max-w-7xl mx-auto">
            <div className="text-center mb-16 space-y-4">
              <h2 className="text-5xl font-black text-white">
                The Weekly Workflow
              </h2>
              <p className="text-xl text-slate-400">Four steps. Completely automated. Watch your releases publish live.</p>
            </div>

            <div className="mb-16">
              <div className="relative">
                <div className="absolute top-16 left-0 right-0 h-1 bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500 opacity-30" />
                
                <div className="grid md:grid-cols-4 gap-6 relative z-10">
                  {workflow.map((step, idx) => (
                    <div key={step.day}>
                      <button
                        onClick={() => handleDayChange(step.day)}
                        className={`w-full relative group`}
                      >
                        <div
                          className={`p-6 rounded-2xl backdrop-blur-xl border-2 transition-all duration-300 cursor-pointer transform hover:scale-105 ${
                            currentDay === step.day
                              ? `bg-gradient-to-br ${step.color} border-white shadow-2xl`
                              : step.completed
                              ? 'bg-slate-800/50 border-slate-700 hover:border-purple-400'
                              : 'bg-slate-800/30 border-slate-700/50 opacity-50'
                          }`}
                        >
                          <div className="text-center mb-4">
                            <div className="text-5xl mb-2">{step.icon}</div>
                            <p className={`text-lg font-bold ${currentDay === step.day ? 'text-white' : 'text-slate-300'}`}>
                              {step.dayName}
                            </p>
                            <p className={`text-sm ${currentDay === step.day ? 'text-white/80' : 'text-slate-400'}`}>
                              {step.time}
                            </p>
                          </div>

                          <p className={`text-center font-bold mb-3 ${currentDay === step.day ? 'text-white' : 'text-slate-300'}`}>
                            {step.action}
                          </p>

                          <p className={`text-xs text-center ${currentDay === step.day ? 'text-white/80' : 'text-slate-400'}`}>
                            {step.description}
                          </p>

                          <div className="mt-4 pt-4 border-t border-white/20 text-center">
                            {step.completed ? (
                              <span className={`text-xs font-bold ${currentDay === step.day ? 'text-white' : 'text-green-400'}`}>
                                ✅ Automated
                              </span>
                            ) : (
                              <span className={`text-xs font-bold ${currentDay === step.day ? 'text-white' : 'text-slate-400'}`}>
                                Awaiting...
                              </span>
                            )}
                          </div>
                        </div>
                      </button>

                      {idx < workflow.length - 1 && (
                        <div className="absolute right-0 top-1/3 -translate-y-1/2 translate-x-12 text-3xl opacity-50">
                          →
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div className="mt-16 p-8 rounded-2xl bg-gradient-to-r from-purple-500/10 to-pink-500/10 border border-purple-500/30 backdrop-blur-xl">
              {currentDay === 'monday' && (
                <div className="space-y-6">
                  <h3 className="text-2xl font-bold text-white">Monday 9:00 AM - Send Form Notification</h3>
                  <p className="text-slate-300">Teams receive the Google Form link in Cliq. They have until Wednesday 11:59 PM to submit their release notes.</p>
                  <div className="grid md:grid-cols-3 gap-4">
                    {teams.map(team => (
                      <button
                        key={team.id}
                        onClick={() => handleSubmit(team.id)}
                        className={`p-4 rounded-xl transition-all ${
                          submissions[team.id]
                            ? `bg-gradient-to-r ${team.color} text-white shadow-lg`
                            : 'bg-slate-800/50 text-slate-300 hover:bg-slate-800'
                        }`}
                      >
                        <p className="font-bold mb-2">{team.name}</p>
                        <p className="text-sm">{submissions[team.id] ? '✅ Notification Sent' : '⏳ Pending'}</p>
                      </button>
                    ))}
                  </div>
                </div>
              )}

              {currentDay === 'wednesday' && (
                <div className="space-y-6">
                  <h3 className="text-2xl font-bold text-white">Wednesday 5:00 PM - Check Submissions</h3>
                  <p className="text-slate-300">Check who has submitted. Send a reminder to those who haven't.</p>
                  <div className="grid md:grid-cols-3 gap-4">
                    {teams.map(team => (
                      <div
                        key={team.id}
                        className="p-4 rounded-xl bg-slate-800/50 border border-slate-700"
                      >
                        <p className="font-bold text-white mb-2">{team.name}</p>
                        {submissions[team.id] ? (
                          <div className="flex items-center gap-2 text-green-400">
                            <CheckCircle size={16} />
                            <span className="text-sm">Submitted</span>
                          </div>
                        ) : (
                          <div className="flex items-center gap-2 text-yellow-400">
                            <AlertCircle size={16} />
                            <span className="text-sm">Remind</span>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {currentDay === 'thursday' && (
                <div className="space-y-6">
                  <h3 className="text-2xl font-bold text-white">Thursday 2:00 PM - Get Missing List</h3>
                  <p className="text-slate-300">Receive a list of all teams that haven't submitted. Escalate if needed.</p>
                  <div className="bg-slate-900/50 p-4 rounded-xl border border-slate-700">
                    <p className="text-sm text-slate-300 mb-3">Missing Submissions:</p>
                    <div className="space-y-2">
                      {teams
                        .filter(t => !submissions[t.id])
                        .map(team => (
                          <div key={team.id} className="flex items-center gap-3 text-slate-400">
                            <AlertCircle size={16} className="text-red-400" />
                            {team.name}
                          </div>
                        ))}
                      {Object.values(submissions).every(v => v) && (
                        <p className="text-green-400 font-bold">✅ All teams submitted!</p>
                      )}
                    </div>
                  </div>
                </div>
              )}

              {currentDay === 'friday' && (
                <div className="space-y-6">
                  <h3 className="text-2xl font-bold text-white">Friday 8:00 AM - Review & Go Live</h3>
                  <p className="text-slate-300">Review submissions in Google Sheets. Click "Go Live" to publish approved releases to Vercel.</p>
                  
                  <div className="space-y-4">
                    <div className="grid md:grid-cols-3 gap-4">
                      {teams.map(team => (
                        <div
                          key={team.id}
                          className={`p-4 rounded-xl border-2 transition-all ${
                            submissions[team.id]
                              ? 'bg-green-500/10 border-green-500/50'
                              : 'bg-slate-800/50 border-slate-700'
                          }`}
                        >
                          <p className={`font-bold mb-2 ${submissions[team.id] ? 'text-green-400' : 'text-slate-300'}`}>
                            {team.name}
                          </p>
                          <p className={`text-sm ${submissions[team.id] ? 'text-green-400' : 'text-slate-400'}`}>
                            {submissions[team.id] ? '✅ Ready to publish' : '⏸️ Not submitted'}
                          </p>
                        </div>
                      ))}
                    </div>

                    <button
                      onClick={handlePublish}
                      disabled={!Object.values(submissions).some(v => v)}
                      className={`w-full py-6 rounded-xl font-bold text-lg transition-all transform ${
                        isPublished
                          ? 'bg-gradient-to-r from-green-500 to-emerald-500 text-white shadow-2xl shadow-green-500/50'
                          : Object.values(submissions).some(v => v)
                          ? 'bg-gradient-to-r from-purple-500 to-pink-500 text-white hover:shadow-2xl hover:shadow-purple-500/50 hover:scale-105'
                          : 'bg-slate-700 text-slate-400 cursor-not-allowed opacity-50'
                      }`}
                    >
                      {isPublished ? '✅ Published to Vercel!' : '🚀 Go Live on Vercel'}
                    </button>
                  </div>

                  {isPublished && (
                    <div className="p-4 rounded-xl bg-green-500/10 border border-green-500/50">
                      <p className="text-green-400 font-bold text-center">
                        ✨ Releases are now live on releases.brightchamps.com
                      </p>
                    </div>
                  )}
                </div>
              )}
            </div>
          </div>
        </div>

        <div className="py-20 px-6">
          <div className="max-w-7xl mx-auto">
            <h2 className="text-4xl font-black text-white text-center mb-16">
              Your Weekly Timeline
            </h2>

            <div className="space-y-8">
              {workflow.map((step, idx) => (
                <div key={step.day} className="relative pl-24">
                  <div className={`absolute left-0 top-2 w-8 h-8 rounded-full flex items-center justify-center text-xl transition-all ${
                    step.completed
                      ? 'bg-gradient-to-r from-green-500 to-emerald-500 shadow-lg shadow-green-500/50'
                      : 'bg-slate-700 border-2 border-purple-500/50'
                  }`}>
                    {step.completed ? '✓' : idx + 1}
                  </div>

                  <div className="bg-slate-800/30 border border-slate-700/50 rounded-xl p-6 backdrop-blur-sm hover:border-purple-500/30 transition-all">
                    <div className="grid md:grid-cols-4 gap-6 items-start">
                      <div>
                        <p className="text-2xl font-black bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
                          {step.dayName}
                        </p>
                        <p className="text-slate-400 text-sm">{step.time}</p>
                      </div>
                      <div>
                        <p className="font-bold text-white">{step.action}</p>
                        <p className="text-slate-400 text-sm mt-1">{step.description}</p>
                      </div>
                      <div className="md:col-span-2">
                        {step.day === 'friday' && (
                          <button
                            onClick={handlePublish}
                            disabled={!Object.values(submissions).some(v => v)}
                            className="px-6 py-3 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-bold rounded-lg hover:shadow-lg hover:shadow-purple-500/50 transition-all disabled:opacity-50 disabled:cursor-not-allowed w-full"
                          >
                            🚀 Go Live Now
                          </button>
                        )}
                        {step.completed && step.day !== 'friday' && (
                          <div className="text-green-400 font-bold flex items-center gap-2">
                            <CheckCircle size={20} />
                            Automated
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div className="py-20 px-6">
          <div className="max-w-4xl mx-auto text-center space-y-8">
            <div className="space-y-4">
              <h2 className="text-5xl font-black text-white">
                Ready to Automate?
              </h2>
              <p className="text-xl text-slate-300">
                Set up your release notes automation in 3-4 hours. Save 2+ hours every week.
              </p>
            </div>

            <div className="flex gap-4 justify-center">
              <button className="px-8 py-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-bold rounded-xl hover:shadow-2xl hover:shadow-purple-500/50 transition-all transform hover:scale-105">
                Start Setup Guide
              </button>
              <button className="px-8 py-4 border-2 border-purple-400 text-purple-300 font-bold rounded-xl hover:bg-purple-500/10 transition-all">
                View Docs
              </button>
            </div>
          </div>
        </div>
      </div>

      <style jsx>{`
        @keyframes float {
          0%, 100% { transform: translateY(0px); }
          50% { transform: translateY(-20px); }
        }
      `}</style>
    </div>
  );
}
